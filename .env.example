# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile

POSTGRES_USER=reviewflow
POSTGRES_PASSWORD=reviewflow_dev
POSTGRES_DB=reviewflow

AUTOPILOT_INTERVAL_SECONDS=60
AUTO_REPLY_MIN_CONFIDENCE=0.85

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Only needed when you switch from local Postgres to hosted Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- optional ---
SEED_DEMO=true                 # set false in production
SUPABASE_JWT_SECRET=           # set to enforce Supabase auth on the API
GOOGLE_PLACES_API_KEY=         # enables the google_places connector (reads latest 5 reviews)
